<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Package.swift の linkerSettings (-sectcreate __TEXT __info_plist) で
	     kilde 実行ファイルに埋め込まれる。バンドルを持たない CLI でも TCC が
	     このプロセス自身を識別し、usage description を解決できるようにする。 -->
	<key>CFBundleIdentifier</key>
	<string>dev.kilde.cli</string>
	<key>CFBundleName</key>
	<string>kilde</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>kilde は --audio mic / device: 指定時にマイクや入力デバイスの音声を録音するためにマイクへのアクセスを使用します。</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
</dict>
</plist>
