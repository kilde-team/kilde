<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: Mac App Store 配布では必須 (issue #126)。直接配布版の
	     KildeGUI.entitlements には無い — MAS ターゲット専用 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- App Group: 録画の排他ロック (KildeCore の SCKStartupLock、kilde-cli-swift#31) が
	     App Group コンテナに置かれるため必須。kilde-cli-swift 側の
	     SCKStartupLock.appGroupIdentifier と完全一致させる契約
	     (kilde-cli-swift の docs/SPIKE-NOTES.md F-N)。これが無くても containerURL は
	     共有パスを返すため黙っては検出できず、書き込みだけサンドボックスに拒否されて
	     録画開始が「録画の排他ロックを作成できません (errno=1)」で落ちる
	     (macOS 27 実測、issue #288)。直接配布版は非サンドボックスなので不要 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>4B873Q67MK.kilde</string>
	</array>
	<!-- マイク。Hardened Runtime 下で MicStream を使うには必須 (issue #18 と同じ理由)。
	     欠けるとエラーもクラッシュもなく無音のトラックになる -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- 録画の保存先の既定 (~/Movies)。これが無いとサンドボックス下では
	     アプリコンテナ内にしか書けず、ユーザーが QuickTime 等と同じ場所に
	     録画を保存できない -->
	<key>com.apple.security.assets.movies.read-write</key>
	<true/>
	<!-- 保存先ディレクトリを NSOpenPanel (powerbox) で選ばせ、そのディレクトリへの
	     アクセスを得るため。設定ファイル (config.json) 経由で知ったパスには
	     このエンタイトルメントでもアクセスできない点に注意 (docs/DEVELOPMENT.md) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 選択した保存先を security-scoped bookmark として保存し、再起動後も
	     アクセスを復元するために必須。user-selected.read-write だけでは
	     アクセスはプロセスの生存中限り -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- 外向き接続。2 つの用途: (1) Firebase Analytics が利用統計を Google の
	     サーバーへ送る。App Sandbox 下では無いと接続自体が拒否され、MAS 版だけ
	     黙って解析イベントが届かなくなる (cubic レビュー指摘)。
	     (2) 文字起こしの言語モデルの取得 (issue #148)。SpeechTranscriber の
	     installModelAsset が Apple のサーバーからモデルをダウンロードする —
	     文字起こし自体は完全オンデバイスだが、必要言語のモデルが端末に無い
	     ときの取得は外向き接続が要る。Firebase を外すときはこのキーを消さないこと -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
