{
  "sourceLanguage": "ja",
  "strings": {
    "${applicationName} で最新の文字起こしを取得": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get latest transcript from ${applicationName}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener la última transcripción de ${applicationName}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName}에서 최근 텍스트 변환 가져오기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从${applicationName}获取最新转写文本"
          }
        }
      }
    },
    "${applicationName} で録画を停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop recording with ${applicationName}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener grabación con ${applicationName}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName}에서 녹화 중지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName}停止录制"
          }
        }
      }
    },
    "${applicationName} で録画を開始": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording with ${applicationName}"
          }
        },
        "es": {
