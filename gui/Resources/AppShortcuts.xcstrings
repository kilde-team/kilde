            "value": "Iniciar grabación con ${applicationName}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName}에서 녹화 시작"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName}开始录制"
          }
