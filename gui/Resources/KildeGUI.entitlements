<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime 下でマイク・入力デバイス (MicStream / AVCaptureSession) を使うのに必須。
	     欠けるとクラッシュもエラーもなく無音のトラックになる (issue #17 の project.yml コメント参照) -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- ローカル開発ビルド専用 (issue #212)。kilde-dev のような自己署名証明書には Team ID が
	     無く、Hardened Runtime のライブラリ検証が埋め込みフレームワーク (Sparkle.framework 等)
	     を「Team ID 不一致」で拒否して dyld が起動直後に落とす。同じ kilde-dev で署名し直しても
	     Team ID が無いため通らない (issue #212 で確認)。
	     このファイルは Xcode でのローカル署名にだけ使われ、配布物の署名 (scripts/release/sign.sh)
	     は scripts/release/entitlements.plist を使うため、配布物のライブラリ検証は有効のまま。
	     sign.sh をこのファイルに切り替える場合は、このキーを配布物に持ち込まないこと -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
