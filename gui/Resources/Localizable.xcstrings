    "システム設定 → プライバシーとセキュリティ → マイク で kilde を許可してください" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow kilde in System Settings → Privacy & Security → Microphone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite kilde en Ajustes del Sistema → Privacidad y seguridad → Micrófono"
