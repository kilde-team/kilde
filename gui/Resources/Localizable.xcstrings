    "ウィンドウ収録ではシステム音声もそのアプリの音だけになります": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When capturing a window, system audio is limited to that app's sound"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al capturar una ventana, el audio del sistema se limita al sonido de esa app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 캡처에서는 시스템 오디오도 해당 앱의 소리만 녹음됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口录制时，系统声音也仅限于该应用的声音"
          }
        }
      }
    },
    "グローバルホットキー": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global Hotkey"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tecla rápida global"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 단축키"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键"
          }
        }
      }
    },
    "システム設定 → プライバシーとセキュリティ → マイク で kilde を許可してください": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow kilde in System Settings → Privacy & Security → Microphone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite kilde en Ajustes del Sistema → Privacidad y seguridad → Micrófono"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 마이크 에서 kilde를 허용하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 系统设置 → 隐私与安全性 → 麦克风 中允许 kilde"
          }
        }
      }
    },
    "システム設定 → プライバシーとセキュリティ → 画面とオーディオを収録 で kilde を許可してください": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow kilde in System Settings → Privacy & Security → Screen & System Audio Recording"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite kilde en Ajustes del Sistema → Privacidad y seguridad → Grabación de pantallas y audio del sistema"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 화면 및 시스템 오디오 녹음 에서 kilde를 허용하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 系统设置 → 隐私与安全性 → 屏幕与系统音频录制 中允许 kilde"
          }
        }
      }
    },
    "システム設定で許可したら、kilde を終了して起動し直してください (許可は再起動後に反映されます)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After granting access in System Settings, quit and relaunch kilde (the permission takes effect after a restart)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras conceder el permiso en Ajustes del Sistema, sal y vuelve a abrir kilde (el permiso se aplica tras reiniciar)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 허용한 후 kilde를 종료하고 다시 실행하세요(권한은 재시작 후 적용됩니다)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中授权后，请退出并重新启动 kilde（权限在重启后生效）"
          }
        }
      }
    },
    "システム設定を開く": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes del Sistema"
          }
        },
