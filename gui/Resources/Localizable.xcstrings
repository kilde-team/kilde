        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "kilde — %@"
          }
        }
      }
    },
    "~/.kilde/config.json に保存します (CLI の kilde rec の既定値も変わります)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves to ~/.kilde/config.json (also changes the defaults of the kilde rec CLI)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en ~/.kilde/config.json (también cambia los valores predeterminados del CLI kilde rec)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.kilde/config.json에 저장합니다(CLI kilde rec의 기본값도 변경됩니다)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到 ~/.kilde/config.json（也会更改 kilde rec 命令行工具的默认值）"
          }
        }
      }
    },
    "「許可する」を押すと確認ダイアログが出ます": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressing Request Permission shows the confirmation dialog"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pulsar «Solicitar permiso» aparece el diálogo de confirmación"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘권한 요청’을 누르면 확인 대화상자가 나타납니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“请求权限”后会显示确认对话框"
          }
        }
      }
    },
    "このアプリの設定に保存します (録画が終わると自動で文字起こしします)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves to this app's settings (transcription starts automatically when the recording ends)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en la configuración de esta app (la transcripción comienza automáticamente cuando termina la grabación)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 설정에 저장합니다 (녹화가 끝나면 자동으로 텍스트 변환합니다)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到此应用的设置 (录制结束后自动进行转写)"
          }
        }
      }
    },
    "この会議は録音しています。議事録を作成するため、音声を録音させてください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This meeting is being recorded. Audio is recorded to create meeting notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta reunión se está grabando; el audio se graba para crear el acta de la reunión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의는 회의록 작성을 위해 녹음되고 있습니다. 음성 녹음을 허락해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会议正在录音,录音用于生成会议记录。"
          }
        }
      }
    },
    "この機能は macOS 14.2 以降で利用できます": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature requires macOS 14.2 or later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función requiere macOS 14.2 o posterior"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능은 macOS 14.2 이상에서 사용할 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能需要 macOS 14.2 或更高版本"
          }
        }
      }
    },
    "この環境では文字起こしを利用できません (macOS 26 以降で、対応言語の音声データが必要です)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription is not available in this environment (requires macOS 26 or later and speech data for a supported language)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción no está disponible en este entorno (requiere macOS 26 o posterior y datos de voz de un idioma compatible)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경에서는 텍스트 변환을 사용할 수 없습니다 (macOS 26 이상 및 지원 언어의 음성 데이터가 필요합니다)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此环境无法使用文字转写（需要 macOS 26 或更高版本以及所支持语言的语音数据）"
          }
        }
      }
    },
    "この音声・保存先の選択を既定にする": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make this audio & save location selection the default"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer predeterminada esta selección de audio y ubicación"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 오디오·저장 위치 선택을 기본값으로 저장"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此音频和保存位置的选择设为默认"
          }
        }
      }
    },
