        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 개인정보 보호 및 보안 → 마이크 에서 kilde를 허용하세요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 系统设置 → 隐私与安全性 → 麦克风 中允许 kilde"
          }
        }
      }
    },
    "システム設定 → プライバシーとセキュリティ → 画面とオーディオを収録 で kilde を許可してください" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow kilde in System Settings → Privacy & Security → Screen & System Audio Recording"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite kilde en Ajustes del Sistema → Privacidad y seguridad → Grabación de pantallas y audio del sistema"
