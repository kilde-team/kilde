    "~/.kilde/config.json に保存します (CLI の kilde rec の既定値も変わります)" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves to ~/.kilde/config.json (also changes the defaults of the kilde rec CLI)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en ~/.kilde/config.json (también cambia los valores predeterminados del CLI kilde rec)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
