<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<!-- 対応言語の宣言 (issue #137)。文字列カタログ Localizable.xcstrings と揃える —
	     ja は開発地域 (キー兼既定値)、en / zh-Hans / ko / es を収録する。
	     この宣言が無いと、システムと App Store が対応言語を正しく認識できず、
	     ユーザーの言語設定でアプリが日本語のまま表示されることがある -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
		<string>en</string>
		<string>zh-Hans</string>
		<string>ko</string>
		<string>es</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<!-- アセットカタログのアイコン名。macOS 11 以降と Mac App Store は
	     CFBundleIconFile ではなくこのキーでアイコンを解決する。
	     project.yml の ASSETCATALOG_COMPILER_APPICON_NAME と必ず揃える -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- App Store への提出で必須 (欠けるとアップロード時に "The Info.plist must contain a
	     LSApplicationCategoryType key" で拒否される)。App Store Connect の一次カテゴリ
	     「ユーティリティ」と揃える -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>KildeGUI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- 輸出コンプライアンス (App Store Connect)。kilde は暗号化 API を使わない。
	     App Store 版は Firebase Analytics の送信 (issue #135) で外向き接続
	     (com.apple.security.network.client) のエンタイトルメントを持つが、
	     すべて OS 標準の HTTPS で免除対象のため「免除対象外の暗号化なし」= false。
	     このキーが無いとアップロードのたびに ASC で申告を求められ、ビルドが
	     「コンプライアンスがありません」で止まる。独自の暗号化を足したら見直すこと -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- メニューバーのみのアプリ: Dock に出さない (DESIGN.md §9) -->
	<key>LSUIElement</key>
	<true/>
	<!-- GUI はバンドルを持つため、CLI の sectcreate 埋め込みではなく
	     通常の Info.plist で権限の説明を宣言する -->
	<key>NSMicrophoneUsageDescription</key>
	<string>会議の自分の声を録音するためにマイクへアクセスします。</string>
	<!-- macOS 15+ で画面収録権限ダイアログ/システム設定に表示される説明文字列。
	     キー名は NSScreenCaptureUsageDescription (ScreenCaptureKit の公式キー) -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>画面と会議アプリの音声を収録するために画面収録へアクセスします。</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Sparkle による GUI の自動更新 (issue #122)。フィードは GitHub Releases の
	     appcast.xml (latest download の固定 URL — Release を作るたびに置き換わる)。
	     SU* キーは UserDefaults が Info.plist より優先されるため、ローカル検証では
	     defaults write で差し替えられる (docs/DEVELOPMENT.md §3) -->
	<key>SUFeedURL</key>
	<string>https://github.com/kilde-team/kilde/releases/latest/download/appcast.xml</string>
	<!-- EdDSA 検証の公開鍵 (generate_keys -p の出力)。対応する秘密鍵を失うと
	     この鍵で署名されたアプリへの更新ができなくなる (docs/RELEASE.md) -->
	<key>SUPublicEDKey</key>
	<string>RoQa7eL0MHYfskU9F75G4g0Bt4NAWaGvXqDLftHnXuw=</string>
</dict>
</plist>
